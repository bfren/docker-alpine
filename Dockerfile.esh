# syntax=docker/dockerfile:1

#======================================================================================================================
# STAGE 0: store build information
#======================================================================================================================

FROM --platform=${BUILDPLATFORM} quay.io/bfren-bin/alpine:<%= ${ALPINE_VERSION} %> AS build
ARG TARGETPLATFORM

RUN \
    # save platform and version information to log
    echo "Platform: ${TARGETPLATFORM}" >> /log && \
    echo "Alpine: <%= ${ALPINE_VERSION} %>" >> /log && \
    echo "Busybox: <%= ${BUSYBOX_VERSION} %>" >> /log && \
    echo "txiki.js: <%= ${TJS_VERSION} %>" >> /log


#======================================================================================================================
# STAGE 1: load busybox
#======================================================================================================================

FROM quay.io/bfren-bin/busybox:<%= ${BUSYBOX_IMAGE} %> AS busybox


#======================================================================================================================
# STAGE 2: load txikijs
#======================================================================================================================

FROM quay.io/bfren-bin/txikijs:<%= ${TJS_IMAGE} %> AS txikijs


#======================================================================================================================
# STAGE 3: load figlet
#======================================================================================================================

FROM quay.io/bfren-bin/figlet:<%= ${FIGLET_IMAGE} %> AS figlet


#======================================================================================================================
# STAGE 4: install bfren platform
#======================================================================================================================

FROM quay.io/bfren-bin/alpine:<%= ${ALPINE_VERSION} %> AS install
COPY --from=build /log /etc/bf/BUILD
COPY --from=busybox / /bin
COPY --from=txikijs / /bin
COPY --from=figlet / /

ARG BF_IMAGE
ARG BF_PUBLISHING
ARG BF_VERSION

RUN \
    # install busybox
    busybox --install

ENV \
    # path to bf configuration - installation script requires this
    BF_ETC=<%= ${BF_ETC} %> \
    # set container to this timezone
    BF_TZ=Europe/London \
    # whether or not to upgrade packages during installation
    #   0: no
    #   1: yes
    BF_UPGRADE_PACKAGES=1 \
    # txiki.js version string to check against installed version after installation
    TJS_VERSION=<%= ${TJS_VERSION} %>

# tests are copied with everything else so bf-install removes them from published images (BF_PUBLISHING=1)
COPY ./overlay /
COPY ./<%= ${ALPINE_EDITION} %>/overlay /

RUN \
    # setup txiki.js using preinstallation script
    chmod +x /preinstall && /preinstall && \
    # ca-certificates is required but we don't want Debian to install it
    apk add --no-cache ca-certificates && \
    # run standard bf installation executable - tjsh is not available until preinstall has run
    tjs run --import-map /etc/tjs/map.json <%= ${BF_BIN} %>/bf-install.js


#======================================================================================================================
# STAGE 5: create final image
#======================================================================================================================

FROM scratch AS final
COPY --from=install / /

LABEL org.opencontainers.image.description="Alpine Linux with txiki.js."
LABEL org.opencontainers.image.source="https://github.com/bfren/docker-alpine"

ENV \
    # debug log output
    #   0: disable
    #   1: enable
    BF_DEBUG=0 \
    # path to bfren configuration directory
    BF_ETC=<%= ${BF_ETC} %> \
    # add bfren executables to PATH
    PATH=<%= ${BF_BIN} %>:${PATH}

ENTRYPOINT [ "/init" ]
